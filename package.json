{
  "name": "ds-universal",
  "version": "0.6.1",
  "description": "DigiSpice Universal Suite - GPS Data Logger Communication & Motorsports Telemetry Analyser",
  "author": {
    "name": "oud0n",
    "email": "oud0n@users.noreply.github.com"
  },
  "desktopName": "ds-universal.desktop",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "start:prod": "npm run build && electron .",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oud0n/ds_universal.git"
  },
  "keywords": [
    "digispice",
    "telemetry",
    "gps",
    "motorsports",
    "data-logger"
  ],
  "dependencies": {
    "lucide-react": "^1.16.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^41.0.2",
    "electron-builder": "^26.7.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "wait-on": "^9.0.4"
  }
}
